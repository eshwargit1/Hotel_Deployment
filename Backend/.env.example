# Supabase PostgreSQL Connection String:
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI) / Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Port (defaults to 5000)
PORT=5000

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN=*
